{
  "$defs": {
    "LLMLiteral": {
      "additionalProperties": false,
      "description": "A candidate entity that the model judged to be used literally.",
      "properties": {
        "text": {
          "description": "Exact substring of the poem",
          "type": "string"
        },
        "start": {
          "description": "Zero-based Unicode code point offset",
          "type": "integer"
        },
        "end": {
          "description": "Exclusive end offset",
          "type": "integer"
        },
        "entity_type": {
          "enum": [
            "plant",
            "animal",
            "natural_phenomenon",
            "landscape",
            "celestial",
            "body",
            "person",
            "artifact",
            "abstract",
            "other"
          ],
          "type": "string"
        },
        "reasoning": {
          "description": "Write exclusively in Russian using Cyrillic. Never use Chinese, Kazakh, or English here; quoted source words stay unchanged.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "start",
        "end",
        "entity_type",
        "reasoning"
      ],
      "type": "object"
    },
