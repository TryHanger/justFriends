{
  "$defs": {
    "EntityCandidate": {
      "additionalProperties": false,
      "description": "Module B output: a possible carrier of figurative meaning and its usage decision.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "entity_type": {
          "enum": [
            "plant",
            "animal",
            "natural_phenomenon",
            "landscape",
            "celestial",
            "body",
            "person",
            "artifact",
            "abstract",
            "other"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "usage_type": {
          "anyOf": [
            {
              "enum": [
                "metaphorical",
                "literal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None: extracted but not yet classified (module C)",
          "title": "Usage Type"
        },
        "origin": {
          "default": "model",
          "description": "lexicon, model or human",
          "title": "Origin",
          "type": "string"
        },
        "lexicon_meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lexicon Meaning"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        }
      },
      "required": [
        "text",
        "start",
        "end",
        "entity_type"
      ],
      "title": "EntityCandidate",
      "type": "object"
    },
    "MetaphorSpan": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "label": {
          "enum": [
            "metaphor",
            "simile",
            "personification",
            "metonymy",
            "idiom"
          ],
          "title": "Label",
          "type": "string"
        },
        "source_domain": {
          "title": "Source Domain",
          "type": "string"
        },
        "target_domain": {
          "title": "Target Domain",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Entity: key image word inside text",
          "title": "Entity"
        },
        "entity_type": {
          "anyOf": [
            {
              "enum": [
                "plant",
                "animal",
                "natural_phenomenon",
                "landscape",
                "celestial",
                "body",
                "person",
                "artifact",
                "abstract",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Type"
        },
        "usage_type": {
          "default": "metaphorical",
          "enum": [
            "metaphorical",
            "literal"
          ],
          "title": "Usage Type",
          "type": "string"
        },
        "context_sentence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Line or sentence of the source text containing the span",
          "title": "Context Sentence"
        },
        "semantic_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short conventional meaning, e.g. 'благородный муж' for 兰",
          "title": "Semantic Label"
        },
        "sentiment": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "neutral",
                "negative"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentiment"
        },
        "tenor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tenor: what is described, e.g. 火",
          "title": "Tenor"
        },
        "tenor_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenor Start"
        },
        "tenor_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenor End"
        },
        "ground": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ground: shared property, e.g. 折磨的感觉",
          "title": "Ground"
        }
      },
      "required": [
        "text",
        "start",
        "end",
        "label",
        "source_domain",
        "target_domain",
        "confidence",
        "rationale"
      ],
      "title": "MetaphorSpan",
      "type": "object"
    },
    "StanzaLabel": {
      "additionalProperties": false,
      "description": "Stanza type after Zhu Xi (詩經集傳): 賦 description, 比 comparison, 興 evocative image.\n\nA model suggestion with its probabilities, not an expert annotation.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "label": {
          "enum": [
            "賦",
            "比",
            "興"
          ],
          "title": "Label",
          "type": "string"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "賦",
              "比",
              "興"
            ]
          },
          "title": "Probabilities",
          "type": "object"
        }
      },
      "required": [
        "text",
        "start",
        "end",
        "label",
        "probabilities"
      ],
      "title": "StanzaLabel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "language": {
      "enum": [
        "zh",
        "kk"
      ],
      "title": "Language",
      "type": "string"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "metaphors": {
      "items": {
        "$ref": "#/$defs/MetaphorSpan"
      },
      "title": "Metaphors",
      "type": "array"
    },
    "needs_review": {
      "default": true,
      "title": "Needs Review",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/EntityCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "method": {
      "additionalProperties": true,
      "description": "Reproducibility record: prompt strategy, decoding parameters, lexicon version",
      "title": "Method",
      "type": "object"
    },
    "stanzas": {
      "description": "Chinese only: stanza types 賦/比/興 suggested by a model",
      "items": {
        "$ref": "#/$defs/StanzaLabel"
      },
      "title": "Stanzas",
      "type": "array"
    }
  },
  "required": [
    "language",
    "model_version",
    "metaphors"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
