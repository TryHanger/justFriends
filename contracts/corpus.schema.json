        "target_domain": {
          "enum": [
            "nature",
            "water",
            "fire",
            "light",
            "darkness",
            "plant",
            "animal",
            "body",
            "person",
            "object",
            "space",
            "motion",
            "journey",
            "time",
            "life",
            "death",
            "emotion",
            "love",
            "mind",
            "society",
            "spirituality",
            "other",
            "unknown"
          ],
