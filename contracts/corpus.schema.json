      "title": "Language",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "author": {
      "title": "Author",
      "type": "string"
    },
    "source_url": {
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "license": {
      "minLength": 1,
      "title": "License",
      "type": "string"
    },
    "license_verified": {
      "default": false,
      "title": "License Verified",
      "type": "boolean"
    },
    "era": {
      "default": "unknown",
      "title": "Era",
      "type": "string"
    },
    "genre": {
      "default": "poetry",
      "title": "Genre",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "annotation_status": {
      "default": "unlabeled",
      "enum": [
        "unlabeled",
        "draft",
        "gold"
      ],
      "title": "Annotation Status",
      "type": "string"
    },
    "annotators": {
      "items": {
        "type": "string"
      },
      "title": "Annotators",
      "type": "array"
    },
    "adjudicator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adjudicator"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/ModelSpan"
      },
      "title": "Spans",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/EntityCandidate"
      },
      "title": "Candidates",
      "type": "array"
    }
