        "rationale": {
          "description": "Write exclusively in Russian using Cyrillic. Never use Chinese, Kazakh, or English here; quoted source words stay unchanged.",
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Entity: key image word inside text",
          "title": "Entity"
        },
        "entity_type": {
          "anyOf": [
            {
              "enum": [
                "plant",
                "animal",
                "natural_phenomenon",
                "landscape",
                "celestial",
                "body",
                "person",
                "artifact",
                "abstract",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Type"
        },
        "usage_type": {
          "default": "metaphorical",
          "enum": [
            "metaphorical",
            "literal"
          ],
          "title": "Usage Type",
          "type": "string"
        },
        "context_sentence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Line or sentence of the source text containing the span",
          "title": "Context Sentence"
        },
        "semantic_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short conventional meaning, e.g. 'благородный муж' for 兰",
          "title": "Semantic Label"
        },
        "sentiment": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "neutral",
                "negative"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentiment"
        }
      },
      "required": [
        "text",
        "start",
        "end",
        "label",
        "source_domain",
        "target_domain",
        "confidence",
        "rationale"
      ],
      "title": "ModelSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "work_id": {
      "minLength": 1,
