{
  "$defs": {
    "ModelSpan": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "label": {
          "enum": [
            "metaphor",
            "simile",
            "personification",
            "metonymy",
            "idiom"
          ],
          "title": "Label",
          "type": "string"
        },
        "source_domain": {
          "enum": [
            "nature",
            "water",
            "fire",
            "light",
            "darkness",
            "plant",
            "animal",
            "body",
            "person",
            "object",
            "space",
            "motion",
            "journey",
            "time",
            "life",
            "death",
            "emotion",
            "love",
            "mind",
            "society",
            "spirituality",
            "other",
            "unknown"
          ],
          "title": "Source Domain",
          "type": "string"
        },
        "target_domain": {
          "enum": [
            "nature",
            "water",
            "fire",
            "light",
            "darkness",
            "plant",
            "animal",
            "body",
            "person",
            "object",
            "space",
            "motion",
            "journey",
            "time",
            "life",
            "death",
            "emotion",
            "love",
            "mind",
            "society",
            "spirituality",
            "other",
            "unknown"
          ],
          "title": "Target Domain",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "rationale": {
          "description": "Write the explanation exclusively in Russian using Cyrillic. Never use Chinese, Kazakh, or English here; leave the quoted source expression unchanged.",
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "text",
        "start",
        "end",
        "label",
        "source_domain",
        "target_domain",
        "confidence",
        "rationale"
      ],
      "title": "ModelSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "work_id": {
      "minLength": 1,
      "title": "Work Id",
      "type": "string"
    },
    "language": {
      "enum": [
        "zh",
        "kk"
      ],
      "title": "Language",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "author": {
      "title": "Author",
      "type": "string"
    },
    "source_url": {
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "license": {
      "minLength": 1,
      "title": "License",
      "type": "string"
    },
    "license_verified": {
      "default": false,
      "title": "License Verified",
      "type": "boolean"
    },
    "era": {
      "default": "unknown",
      "title": "Era",
      "type": "string"
    },
    "genre": {
      "default": "poetry",
      "title": "Genre",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "annotation_status": {
      "default": "unlabeled",
      "enum": [
        "unlabeled",
        "draft",
        "gold"
      ],
      "title": "Annotation Status",
      "type": "string"
    },
    "annotators": {
      "items": {
        "type": "string"
      },
      "title": "Annotators",
      "type": "array"
    },
    "adjudicator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adjudicator"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/ModelSpan"
      },
      "title": "Spans",
      "type": "array"
    }
  },
  "required": [
    "id",
    "work_id",
    "language",
    "text",
    "title",
    "author",
    "source_url",
    "license"
  ],
  "title": "Poem",
  "type": "object"
}
