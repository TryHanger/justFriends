{
  "$defs": {
    "EntityCandidate": {
      "additionalProperties": false,
      "description": "Module B output: a possible carrier of figurative meaning and its usage decision.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "entity_type": {
          "enum": [
            "plant",
            "animal",
            "natural_phenomenon",
            "landscape",
            "celestial",
            "body",
            "person",
            "artifact",
            "abstract",
            "other"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "usage_type": {
          "anyOf": [
            {
              "enum": [
                "metaphorical",
                "literal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None: extracted but not yet classified (module C)",
          "title": "Usage Type"
        },
        "origin": {
          "default": "model",
          "description": "lexicon, model or human",
          "title": "Origin",
          "type": "string"
        },
        "lexicon_meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lexicon Meaning"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        }
      },
      "required": [
        "text",
        "start",
        "end",
        "entity_type"
      ],
      "title": "EntityCandidate",
      "type": "object"
    },
    "ModelSpan": {
