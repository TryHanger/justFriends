APP_NAME=Metaphor Analyzer API
ENVIRONMENT=local
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./metaphors.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
MAX_UPLOAD_MB=20
NLP_BACKEND=openai
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONTEXT_WINDOW=8192
XLMR_MODEL_PATH=models/xlmr
HYBRID_LLM_BACKEND=openai
NLP_REVIEW_THRESHOLD=0.8
NLP_MAX_LENGTH=256
NLP_STRIDE=64
EMBEDDING_MODEL=intfloat/multilingual-e5-base

