APP_NAME=Metaphor Analyzer API
ENVIRONMENT=local
QUALITY_RUNNER_ENABLED=false
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./metaphors.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_UPLOAD_MB=20
NLP_BACKEND=openai
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONTEXT_WINDOW=16384
XLMR_MODEL_PATH=models/xlmr
HYBRID_LLM_BACKEND=openai
NLP_REVIEW_THRESHOLD=0.8
NLP_MAX_LENGTH=256
NLP_STRIDE=64
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# ТЗ: prompt strategy, decoding and resources (see docs/NLP.md)
LLM_PROMPT_STRATEGY=few_shot+cot+rag+lexicon
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.95
RAG_TOP_K=4
# Two-stage analysis: direct usage question for every candidate (empty list = off)
NLP_TWO_STAGE_LANGUAGES=kk
NLP_USAGE_BACKEND=openai
NLP_USAGE_MODEL=gpt-4o
# Also question every Kazakh content word (higher recall, more stage-2 tokens)
NLP_USAGE_ALL_WORDS=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
HF_MODEL=
HF_ADAPTER=
